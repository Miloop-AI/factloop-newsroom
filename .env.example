# Tavily, recent-news search (https://tavily.com)
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com

# OpenRouter, LLM gateway that lets every agent target a different model
# (https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-agent models. Each agent is tuned independently so a role can be upgraded
# or swapped without touching the others; any left blank fall back to
# OPENROUTER_MODEL. The Researcher is pure code and deliberately uses no model.
OPENROUTER_MODEL=

# Language detector, a one-token classification on the busiest path, so it uses
# the cheapest, fastest model
OPENROUTER_MODEL_DETECTOR=google/gemini-2.5-flash-lite
# Translator agent
OPENROUTER_MODEL_TRANSLATOR=anthropic/claude-haiku-4.5
# Journalist agent
OPENROUTER_MODEL_JOURNALIST=google/gemini-2.5-pro
# Fact-Checker agent
OPENROUTER_MODEL_FACTCHECKER=openai/gpt-5
# GEO/SEO Optimizer agent
OPENROUTER_MODEL_GEO=google/gemini-2.5-flash

# Outbound HTTP timeout, in seconds
REQUEST_TIMEOUT_SECONDS=30

# Public API service (api.py). Both have code defaults; override only if needed.
# Comma-separated CORS origins the API accepts
ALLOWED_ORIGIN=https://miloop.ai,http://localhost:8000
# Per-IP limit on POST /generate (slowapi limit string)
RATE_LIMIT=5/hour
